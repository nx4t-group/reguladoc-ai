# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Desenvolvimento local (SQLite — zero configuração):
#   DATABASE_URL="file:./dev.db"
#   (lembre de trocar o provider em prisma/schema.prisma para "sqlite")
#
# Produção (Supabase PostgreSQL):
#   Copie a "Connection String" do painel Supabase → Settings → Database
#   Selecione o modo "URI" (começa com postgresql://...)
#   Adicione ?pgbouncer=true&connection_limit=1 ao final para modo serverless
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Gere um valor aleatório para produção: openssl rand -base64 32
# Em produção, NEXTAUTH_URL deve ser a URL pública do deploy (ex.
# https://reguladoc.vercel.app), não localhost.
NEXTAUTH_SECRET="reguladoc-dev-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Supabase — banco de dados + storage de documentos (produção)
# ---------------------------------------------------------------------------
# Encontre em: painel Supabase → Settings → API
# SUPABASE_URL: "Project URL" (ex: https://xxxxxxxxxxxx.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: "service_role" secret key (NÃO exponha no cliente)
# Quando configurados, os uploads de documentos vão para o bucket "documents"
# no Supabase Storage (privado, com signed URLs de 1h para leitura).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# IA / OCR — camada de adapters (ver src/lib/extraction e src/lib/llm)
# ---------------------------------------------------------------------------
# Nenhuma chave é obrigatória para rodar o MVP: sem chave configurada, o sistema
# usa automaticamente o MockExtractionAdapter / mock LLMService e exibe o aviso
# "Modo simulado" na interface.
#
# "gemini" é um adapter REAL e funcional (não um placeholder): com
# GEMINI_API_KEY configurada, PDFs/imagens enviados são lidos de verdade pela
# API multimodal do Google Gemini. Os demais provedores (google-document-ai,
# vision-ocr, llm) continuam sendo placeholders para a Fase 2.
EXTRACTION_PROVIDER="mock" # mock | gemini | google-document-ai | vision-ocr | llm
LLM_PROVIDER="mock" # mock | openai | anthropic | gemini

GOOGLE_DOCUMENT_AI_API_KEY=""
GOOGLE_VISION_API_KEY=""
GEMINI_API_KEY="" # https://aistudio.google.com/apikey
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Storage de documentos — Vercel Blob (alternativa ao Supabase Storage)
# ---------------------------------------------------------------------------
# Usado apenas se SUPABASE_URL não estiver configurado.
# Criado automaticamente ao adicionar o storage "Blob" a um projeto Vercel.
BLOB_READ_WRITE_TOKEN=""

