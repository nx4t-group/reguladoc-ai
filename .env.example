# Banco de dados. Em desenvolvimento local pode ser SQLite (zero configuração):
#   DATABASE_URL="file:./dev.db"
# Em produção (Vercel), use a connection string de um Postgres hospedado
# (Neon, Vercel Postgres, Supabase etc.) — troque também o `provider` do
# datasource em prisma/schema.prisma de "sqlite" para "postgresql".
DATABASE_URL="file:./dev.db"

# NextAuth — gere um valor aleatório em produção, ex: `openssl rand -base64 32`.
# Em produção, NEXTAUTH_URL deve ser a URL pública do deploy (ex.
# https://reguladoc.seudominio.com), não localhost.
NEXTAUTH_SECRET="reguladoc-dev-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# IA / OCR — camada de adapters (ver src/lib/extraction e src/lib/llm).
# Nenhuma chave é obrigatória para rodar o MVP: sem chave configurada, o sistema
# usa automaticamente o MockExtractionAdapter / mock LLMService e exibe o aviso
# "Modo simulado" na interface.
#
# "gemini" é um adapter REAL e funcional (não um placeholder): com
# GEMINI_API_KEY configurada, PDFs/imagens enviados são lidos de verdade pela
# API multimodal do Google Gemini. Os demais provedores (google-document-ai,
# vision-ocr, llm) continuam sendo placeholders para a Fase 2.
EXTRACTION_PROVIDER="mock" # mock | gemini | google-document-ai | vision-ocr | llm
LLM_PROVIDER="mock" # mock | openai | anthropic | gemini

GOOGLE_DOCUMENT_AI_API_KEY=""
GOOGLE_VISION_API_KEY=""
GEMINI_API_KEY="" # https://aistudio.google.com/apikey
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Storage de documentos. Em desenvolvimento local, arquivos vão para
# storage/uploads/ em disco automaticamente — nada a configurar. Em produção
# (Vercel), defina BLOB_READ_WRITE_TOKEN (criado automaticamente ao adicionar
# o storage "Blob" a um projeto Vercel) para que os uploads passem a usar o
# Vercel Blob, já que hospedagem serverless não mantém disco persistente.
BLOB_READ_WRITE_TOKEN=""
